{
  "name": "tymo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n db,company-web,company-services,tymo-services,tymo-web -c gray,blue,magenta,yellow,green \"npm run dev:db\" \"npm run dev -w @tymo/company-web\" \"npm run dev -w @tymo/company-services\" \"npm run dev -w @tymo/tymo-services\" \"npm run dev -w @tymo/tymo-web\"",
    "dev:db": "tsx packages/company/scripts/dev-db.ts",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run generate -w @tymo/db",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "db:seed": "tsx packages/company/scripts/seed.ts",
    "db:reset": "tsx packages/company/scripts/reset.ts",
    "db:prepare": "tsx packages/company/scripts/prepare.ts"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
