# Copy to .env.local. Every value is optional for local dev:
# with no DATABASE_URL the app uses an embedded PGlite database in ./.data,
# and with no Stripe keys it uses the fake payment provider.

# Postgres (production). Must connect as a role that is a member of tymo_app.
DATABASE_URL=

# Public base URL used in emails and Stripe return links.
APP_URL=http://localhost:3000

# Long random string used to sign staff session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# Protects /api/cron/* (expiry sweeper, reminders, recurring blocks).
CRON_SECRET=change-me

# Payments: "fake" (default when no key) or "stripe".
PAYMENTS_MODE=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Tymo's application fee in basis points (200 = 2%).
TYMO_FEE_BPS=200

# Email: with no RESEND_API_KEY, emails go to the outbox table only
# (viewable at /dev/outbox in development).
RESEND_API_KEY=
EMAIL_FROM=bookings@booktymo.com
