# Next.js apps read their own .env.local (apps/<name>/.env.local). For local
# booking development, `npm run dev` starts an embedded database and uses
# fake payments. The Tymo website reads variables from the process environment.

# Tymo marketing site. Use a dedicated database for quote inquiries.
TYMO_LEADS_DATABASE_URL=

# Shared Postgres (production). Must be able to SET ROLE tymo_app.
DATABASE_URL=

# Public base URL of each app (local defaults shown).
COMPANY_WEB_URL=http://localhost:3000
COMPANY_SERVICES_URL=http://localhost:3001
TYMO_SERVICES_URL=http://localhost:3002
TYMO_WEB_URL=http://localhost:3003
# Company website build: link for "Bookings by Tymo" (defaults to booktymo.com).
NEXT_PUBLIC_TYMO_WEB_URL=
# Company website checkout cookie secret. Generate a unique value for hosted use.
SESSION_SECRET=

# Tymo services: protects /api/cron/tick; TYMO_INTERNAL_CRON=1 runs it every minute.
CRON_SECRET=change-me
TYMO_INTERNAL_CRON=

# Payments: "fake" (default when no key) or "stripe".
PAYMENTS_MODE=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Tymo's application fee in basis points (200 = 2%).
TYMO_FEE_BPS=200

# Email: with no RESEND_API_KEY, emails go to the outbox table only
# (development: http://localhost:3002/dev/outbox).
RESEND_API_KEY=
EMAIL_FROM=bookings@booktymo.com

# Demo deployments only (never for a real facility).
TYMO_DEMO=
TYMO_SEED_DEMO=
# Public facility preview: list fields and availability with checkout disabled.
TYMO_PUBLIC_PREVIEW=
# Optional public proposal profile JSON. Keep it separate from seeded booking data.
TYMO_FACILITY_PROFILE=
